# Morning recap schedule
RECAP_HOUR=8
RECAP_MINUTE=0
RECAP_TIMEZONE=America/New_York
RECAP_DAYS=mon-fri

# Email delivery (leave blank to disable)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=app-password
SMTP_STARTTLS=true
RECAP_EMAIL_FROM=you@example.com
RECAP_EMAIL_TO=you@example.com

# Push delivery via webhook, e.g. Slack or Discord (leave blank to disable)
RECAP_WEBHOOK_URL=
